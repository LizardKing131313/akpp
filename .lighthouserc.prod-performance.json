{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "formFactor": "desktop",
        "screenEmulation": {
          "mobile": false,
          "width": 1350,
          "height": 940,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "onlyCategories": ["performance"]
      },
      "url": ["https://expertakpp.ru/"]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-performance"
    }
  }
}
