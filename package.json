{
  "name": "akpp",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "build:web": "pnpm -C apps/web build",
    "preview:web": "pnpm -C apps/web preview",
    "typecheck:web": "pnpm -C apps/web typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "*.{ts,js,vue,json,css,md}": [
      "prettier --write"
    ]
  }
}
